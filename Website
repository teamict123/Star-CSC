            document.getElementById('paymentFailedStage').style.display = 'none';
            document.getElementById('paymentSuccessStage').style.display = 'none';

            document.getElementById('payServiceHeading').innerText = `${srv.name} ${qty > 1 ? '(Qty: ' + qty + ')' : ''}`;
            document.getElementById('payAmountDisplay').innerText = `₹${amount}`;

            const upiUrl = `upi://pay?pa=${BHARATPE_UPI_ID}&pn=${encodeURIComponent(MERCHANT_NAME)}&am=${amount}&cu=INR&tn=${encodeURIComponent(srv.name.substring(0,25))}`;
