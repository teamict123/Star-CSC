        // PINCODE AUTO-FILL WITH HAPUR DISTRICT OVERRIDE (Fixes old Ghaziabad record)
        async function handlePincodeInput(pincode) {
            const statusMsg = document.getElementById('pincodeStatusMsg');
            const stateInput = document.getElementById('addrStateInput');
            const distInput = document.getElementById('addrDistrictInput');
            const poSelect = document.getElementById('addrPostOfficeSelect');
            const vilSelect = document.getElementById('addrVillageSelect');

            if (pincode.length < 6) {
                statusMsg.style.color = "#64748b";
                statusMsg.innerText = "(6 अंकों का पिनकोड दर्ज करें)";
                stateInput.value = "";
                distInput.value = "";
                poSelect.innerHTML = '<option value="">-- पहले पिनकोड दर्ज करें --</option>';
                vilSelect.innerHTML = '<option value="">-- पहले पोस्ट ऑफिस चुनें --</option>';
                return;
            }

            statusMsg.style.color = "#0b4f8c";
            statusMsg.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> डाक विभाग से डेटा लोड हो रहा है...';

            // SPECIAL PRE-CONFIGURED LOCAL OVERRIDE FOR HAPUR (245101)
            if (pincode === "245101") {
                stateInput.value = "Uttar Pradesh";
                distInput.value = "Hapur (हापुड़)"; // Fixed updated district

                poSelect.innerHTML = '<option value="">-- पोस्ट ऑफिस चुनें --</option>';
                const hapurPOs = ["Dahana", "Babugarh", "Hapur H.O", "Dhaulana", "Pilkhuwa"];
                hapurPOs.forEach(po => {
                    const opt = document.createElement('option');
                    opt.value = po;
                    opt.text = `${po} (Sub Post Office)`;
                    poSelect.appendChild(opt);
                });

                statusMsg.style.color = "#166534";
                statusMsg.innerHTML = "✓ हापुड़ (245101), उत्तर प्रदेश का रिकॉर्ड अपडेटेड मिला!";
                vilSelect.innerHTML = '<option value="">-- अब पोस्ट ऑफिस चुनें --</option>';
                return;
            }

            // DYNAMIC API FETCH FOR OTHER ALL-INDIA PINCODES
            try {
                const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
                const data = await response.json();

                if (data && data[0] && data[0].Status === "Success") {
                    const postOffices = data[0].PostOffice;
                    const first = postOffices[0];

                    stateInput.value = first.State;

                    // If API mistakenly says Ghaziabad for 245xxx series, auto-correct to Hapur
                    if (first.Pincode.startsWith("245") && first.District.toLowerCase().includes("ghaziabad")) {
                        distInput.value = "Hapur (हापुड़)";
                    } else {
                        distInput.value = first.District;
                    }

                    poSelect.innerHTML = '<option value="">-- पोस्ट ऑफिस चुनें --</option>';
                    const addedNames = new Set();

                    postOffices.forEach(po => {
                        if (!addedNames.has(po.Name)) {
                            addedNames.add(po.Name);
                            const opt = document.createElement('option');
                            opt.value = po.Name;
                            opt.text = `${po.Name} [${po.BranchType}]`;
                            poSelect.appendChild(opt);
                        }
                    });

                    statusMsg.style.color = "#166534";
                    statusMsg.innerHTML = `✓ ${distInput.value}, ${first.State} लोड हुआ!`;
                    vilSelect.innerHTML = '<option value="">-- अब पोस्ट ऑफिस चुनें --</option>';
                } else {
                    statusMsg.style.color = "var(--danger)";
                    statusMsg.innerText = "पिनकोड नहीं मिला। कृपया स्वयं विवरण दर्ज करें।";
                    poSelect.innerHTML = '<option value="Other PO">अन्य पोस्ट ऑफिस</option>';
                    vilSelect.innerHTML = '<option value="Other Village">अन्य गाँव</option>';
                }
            } catch (err) {
                console.error("Pincode API error:", err);
                statusMsg.style.color = "var(--danger)";
                statusMsg.innerText = "नेटवर्क समस्या। कृपया स्वयं विवरण दर्ज करें।";
                poSelect.innerHTML = '<option value="Other PO">अन्य पोस्ट ऑफिस</option>';
                vilSelect.innerHTML = '<option value="Other Village">अन्य गाँव</option>';
            }
        }

        // DYNAMIC VILLAGE LIST POPULATION BASED ON SELECTED POST OFFICE
        function handlePostOfficeChange() {
            const po = document.getElementById('addrPostOfficeSelect').value;
            const vilSelect = document.getElementById('addrVillageSelect');
            vilSelect.innerHTML = '<option value="">-- गाँव चुनें --</option>';

            if (!po) return;

            // Check if known local village hierarchy exists
            if (postOfficeVillagesMap[po]) {
                postOfficeVillagesMap[po].forEach(vil => {
                    const opt = document.createElement('option');
                    opt.value = vil;
                    opt.text = vil;
                    vilSelect.appendChild(opt);
                });
            } else {
                // If other district/PO, populate default area + other option
                const opt1 = document.createElement('option');
                opt1.value = `${po} Village / Area`;
                opt1.text = `${po} (मूल गाँव / कस्बा)`;
                vilSelect.appendChild(opt1);

                const opt2 = document.createElement('option');
                opt2.value = `Other Village under ${po}`;
                opt2.text = `+ अन्य गाँव (नीचे बॉक्स में नाम लिखें)`;
                vilSelect.appendChild(opt2);
            }
        }

