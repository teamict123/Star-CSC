                qtyContainer.style.display = 'none';
                bijliBox.style.display = 'none';
                feeAlert.style.display = 'none';
                return;
            }

            const srv = serviceDatabase[taskKey];

            if (srv.allowQty) {
                qtyContainer.style.display = 'flex';
