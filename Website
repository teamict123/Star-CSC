        function calculateBijliCharge(amount) {
            if (!amount || amount <= 0) return 10;
            const charge = Math.ceil(amount / 1000) * 10;
            return Math.max(10, charge);
        }

        function onBijliAmountChange() {
            const amount = parseFloat(document.getElementById('bijliBillAmount').value) || 0;
            const charge = calculateBijliCharge(amount);
            const total = amount + charge;
            document.getElementById('formDisplayFee').innerText = `₹${total} (बिल: ₹${amount} + सेवा शुल्क: ₹${charge})`;
            document.getElementById('feeAlertContainer').style.display = 'block';
        }

