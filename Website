            const addressLines = doc.splitTextToSize(`Address        : ${data.address}`, pageWidth - 40);
            doc.text(addressLines, 18, 81);

            // Service & Payment Box
            doc.setFillColor(248, 250, 252);
            doc.rect(14, 96, pageWidth - 28, 54, 'F');
            doc.rect(14, 96, pageWidth - 28, 54, 'D');

            doc.setFont('helvetica', 'bold');
            doc.setTextColor(11, 79, 140);
            doc.text("SERVICE & PAYMENT TRANSACTION DETAILS", 18, 103);

            doc.setTextColor(30, 30, 30);
            doc.setFont('helvetica', 'normal');
            doc.text(`Service Category : ${data.pdfCategory}`, 18, 110);

            const displayServiceTitle = `${data.pdfTask}${data.qty > 1 ? ' [Qty: ' + data.qty + ']' : ''}${data.pdfCondition ? ' (' + data.pdfCondition + ')' : ''}`;
            doc.text(`Applied Service  : ${displayServiceTitle.substring(0, 75)}`, 18, 117);
            doc.text(`Total Amount     : Rs. ${data.amount}`, 18, 124);
            doc.text(`Payment Mode     : BharatPe UPI QR`, 18, 131);
            
            doc.setFont('helvetica', 'bold');
            doc.setTextColor(22, 101, 52);
            doc.text(`Payment Status   : SUCCESSFUL / VERIFIED`, 18, 138);
            doc.text(`12-Digit UTR No  : ${data.utr}`, 18, 145);

            if (data.bijliInfo || data.details) {
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(70, 70, 70);
                doc.setFontSize(8.5);
                const extra = `${data.bijliInfo ? data.bijliInfo + ' | ' : ''}${data.details || ''}`;
                doc.text(`Notes / Details  : ${extra.substring(0, 105)}`, 18, 155);
            }

            const uploadedKeys = Object.keys(docsMap);
            const docCount = uploadedKeys.length;
            doc.setFillColor(240, 249, 255);
            doc.rect(14, 163, pageWidth - 28, 14, 'F');
            doc.rect(14, 163, pageWidth - 28, 14, 'D');
            doc.setTextColor(3, 105, 161);
            doc.setFontSize(9);
            doc.setFont('helvetica', 'bold');
            doc.text(`ATTACHED DOCUMENTS: ${docCount} Document File(s) Uploaded.`, 18, 169);
            doc.setFont('helvetica', 'normal');
            doc.text(docCount > 0 ? "Uploaded document previews are rendered on the following page(s)." : "No additional document images were attached during submission.", 18, 174);

            // Authorized Seal & Stamp Box Area
            const stampBoxX = pageWidth - 78;
            const stampBoxY = 186;
            const stampBoxW = 64;
            const stampBoxH = 34;

            doc.setDrawColor(180, 180, 180);
            doc.rect(stampBoxX, stampBoxY, stampBoxW, stampBoxH, 'D');
            doc.setTextColor(110, 110, 110);
            doc.setFontSize(8);
            doc.text("Authorized Seal & Stamp", stampBoxX + (stampBoxW / 2), stampBoxY + 5, { align: 'center' });

            const stampImg = await loadStampAsBase64('stamp.png');
            if (stampImg) {
                try {
                    doc.addImage(stampImg, 'PNG', stampBoxX + 18, stampBoxY + 6, 28, 26, undefined, 'FAST');
                } catch(e) { console.log("Stamp render error:", e); }
            } else {
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(11, 79, 140);
                doc.setFontSize(9.5);
                doc.text("STAR JAN SEVA", stampBoxX + (stampBoxW / 2), stampBoxY + 16, { align: 'center' });
                doc.text("KENDRA (HAPUR)", stampBoxX + (stampBoxW / 2), stampBoxY + 22, { align: 'center' });
                doc.setFontSize(7.5);
                doc.setTextColor(212, 154, 55);
                doc.text("[OFFICIALLY VERIFIED]", stampBoxX + (stampBoxW / 2), stampBoxY + 28, { align: 'center' });
            }

            // Footer
            doc.setTextColor(120, 120, 120);
            doc.setFontSize(8);
            doc.setFont('helvetica', 'normal');
            doc.text("This is an official computer-generated receipt issued by Star Jan Seva Kendra.", pageWidth / 2, 282, { align: 'center' });
            doc.text("For any dispute or status query, contact +91 9557054388 or visit the center.", pageWidth / 2, 287, { align: 'center' });

            const readFileAsBase64 = (file) => {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsDataURL(file);
                });
            };

            // PAGE 2+: Document Images Rendering
            if (uploadedKeys.length > 0) {
                for (let i = 0; i < uploadedKeys.length; i++) {
                    const docObj = docsMap[uploadedKeys[i]];
                    const f = docObj.file;
                    if (f && f.type.startsWith('image/')) {
                        try {
                            const imgBase64 = await readFileAsBase64(f);
                            doc.addPage();
                            doc.setFillColor(11, 79, 140);
                            doc.rect(0, 0, pageWidth, 16, 'F');
                            doc.setTextColor(255, 255, 255);
                            doc.setFontSize(10.5);
                            doc.setFont('helvetica', 'bold');
                            doc.text(`ATTACHED DOCUMENT [${i + 1} OF ${uploadedKeys.length}]: ${docObj.name}`, pageWidth / 2, 11, { align: 'center' });

                            doc.addImage(imgBase64, 'JPEG', 15, 22, pageWidth - 30, 245, undefined, 'FAST');
                            doc.setTextColor(120, 120, 120);
                            doc.setFontSize(8);
                            doc.text(`Ref ID: ${data.appId} | Applicant: ${data.name} | Service: ${data.pdfTask}`, pageWidth / 2, 285, { align: 'center' });
                        } catch (err) { console.error("Doc embed error:", err); }
                    }
                }
            }

            doc.save(`Star_CSC_Receipt_${data.appId}.pdf`);
        }

        function forwardApplicationToWhatsApp() {
            if(!pendingApplicationData) return;

            let text = `*🌟 नया ऑनलाइन सेवा आवेदन व भुगतान रसीद 🌟*\n`;
            text += `*स्टार जन सेवा केंद्र (सालेपुर कोटला)*\n`;
            text += `------------------------------------\n`;
            text += `📄 *आवेदन संदर्भ (Ref ID):* ${pendingApplicationData.appId}\n`;
            text += `👤 *ग्राहक का नाम:* ${pendingApplicationData.name}\n`;
            text += `📞 *मोबाइल नंबर:* ${pendingApplicationData.phone}\n`;
            text += `🏡 *पता:* ${pendingApplicationData.address}\n`;
            text += `📂 *सेवा श्रेणी:* ${pendingApplicationData.category}\n`;
            text += `📌 *विशिष्ट सेवा:* ${pendingApplicationData.task} ${pendingApplicationData.qty > 1 ? '[Qty: ' + pendingApplicationData.qty + ']' : ''} ${pendingApplicationData.conditionText ? '(' + pendingApplicationData.conditionText + ')' : ''}\n`;
            if (pendingApplicationData.bijliInfo) {
                text += `⚡ *बिजली विवरण:* ${pendingApplicationData.bijliInfo}\n`;
            }
            text += `💰 *जमा शुल्क (Paid):* ₹${pendingApplicationData.amount}\n`;
            text += `💳 *भुगतान स्थिति:* ✅ SUCCESSFUL (BharatPe UPI)\n`;
            text += `🔢 *12-अंकों का UTR No:* ${pendingApplicationData.utr}\n`;
            if (pendingApplicationData.details) {
                text += `📝 *नोट:* ${pendingApplicationData.details}\n`;
            }
            text += `------------------------------------\n`;
            text += `📎 *नोट:* ग्राहक द्वारा इस संदेश के साथ आधिकारिक पावती रसीद व दस्तावेज़ (PDF) संलग्न कर प्रेषित की जा रही है।`;

            closePaymentModal();
            window.open(`https://wa.me/${CSC_WHATSAPP_PHONE}?text=${encodeURIComponent(text)}`, '_blank');
        }

        window.addEventListener('DOMContentLoaded', () => {
            renderServicesGrid();
        });
    </script>
</body>
</html>
