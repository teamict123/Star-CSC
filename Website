        function handleSingleDocUpload(input, idx, docName) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                currentUploadedDocs[idx] = { name: docName, file: file };
                const prev = document.getElementById(`docPreviewName_${idx}`);
                if (prev) prev.innerText = `✓ ${file.name}`;
            } else {
                delete currentUploadedDocs[idx];
                const prev = document.getElementById(`docPreviewName_${idx}`);
                if (prev) prev.innerText = "";
            }
        }

        function initiatePaymentFlow(event) {
            event.preventDefault();

            const name = document.getElementById('userName').value.trim();
            const phone = document.getElementById('userMobile').value.trim();
            const details = document.getElementById('taskDetails').value.trim();

            if (phone.length !== 10) {
                alert("कृपया 10 अंकों का मान्य मोबाइल नंबर दर्ज करें!");
                document.getElementById('userMobile').focus();
                return;
            }

            // Build Full Formatted Address from Pincode -> PO -> Village Hierarchy
            const pincode = document.getElementById('addrPincodeInput').value.trim();
            const state = document.getElementById('addrStateInput').value.trim();
            const dist = document.getElementById('addrDistrictInput').value.trim();
            const po = document.getElementById('addrPostOfficeSelect').value;
            const village = document.getElementById('addrVillageSelect').value;
            const street = document.getElementById('addrStreetInput').value.trim();

            if (!pincode || !state || !dist || !po || !village) {
                alert("कृपया पिनकोड, पोस्ट ऑफिस और गाँव का चयन पूरा करें!");
                return;
            }

            const formattedAddress = `${village}, Post: ${po}, Dist: ${dist}, State: ${state}, PIN: ${pincode}${street ? ' (' + street + ')' : ''}`;

            const taskKey = isServiceLocked && currentActiveService ? currentActiveService.key : document.getElementById('userSpecificTask').value;
            if(!taskKey || !serviceDatabase[taskKey]) {
                alert("कृपया एक विशिष्ट सेवा चुनें!");
                return;
            }

            const srv = serviceDatabase[taskKey];
            const qty = srv.allowQty ? (parseInt(document.getElementById('serviceQuantityInput').value) || 1) : 1;
            
            let amount = srv.numericFee * qty;
            let feeString = `Rs. ${amount}`;
            let conditionText = "";
            let pdfCondition = "";

            if (srv.conditions) {
                const cIdx = document.getElementById('conditionalChoiceSelect').value;
                const cond = srv.conditions[cIdx];
                amount = cond.fee;
                feeString = `Rs. ${cond.fee} (${cond.feeText})`;
                conditionText = cond.label;
                pdfCondition = cond.pdfCondition;
            }

            // Bijli Bill Validation & Slab Calculation
            let bijliInfo = "";
            if (srv.isBijliBill) {
                const bAmount = parseFloat(document.getElementById('bijliBillAmount').value);
                if (!bAmount || bAmount <= 0) {
                    alert("कृपया बिजली बिल की वैध राशि दर्ज करें!");
                    document.getElementById('bijliBillAmount').focus();
                    return;
                }
                const bCharge = calculateBijliCharge(bAmount);
                amount = bAmount + bCharge;
                feeString = `Rs. ${amount} (Bill: Rs. ${bAmount} + Service Charge: Rs. ${bCharge})`;

                const choice = document.querySelector('input[name="bijliChoice"]:checked').value;
                if (choice === 'acc') {
                    const acc = document.getElementById('bijliAccountInput').value.trim();
                    if (!acc || acc.length !== 10) {
                        alert("कृपया 10-अंकों का वैध बिजली खाता संख्या दर्ज करें!");
                        document.getElementById('bijliAccountInput').focus();
                        return;
                    }
                    bijliInfo = `Account ID: ${acc} | Bill: Rs. ${bAmount} | Charge: Rs. ${bCharge}`;
                } else {
                    if (!currentUploadedDocs['bijli_doc']) {
                        alert("कृपया पुराने बिजली बिल की फोटो संलग्न करें!");
                        return;
                    }
                    bijliInfo = `Bill Slip Uploaded | Bill: Rs. ${bAmount} | Charge: Rs. ${bCharge}`;
                }
            }

            const appRefId = "STAR-" + Math.floor(100000 + Math.random() * 900000);

            pendingApplicationData = {
                appId: appRefId,
                name: name,
                phone: phone,
                address: formattedAddress,
                category: srv.category,
                pdfCategory: srv.pdfCategory || srv.category,
                task: srv.name,
                pdfTask: srv.pdfName || srv.name,
                qty: qty,
                conditionText: conditionText,
                pdfCondition: pdfCondition,
                feeString: feeString,
